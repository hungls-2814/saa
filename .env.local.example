# Copy this file to `.env.local` and fill in your project values.
# See docs/setup/supabase-google-oauth.md and docs/setup/supabase-migrations.md.

# ── App runtime (client-safe, bundled into the browser) ──────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Homepage/pre-launch countdown target (ISO-8601). Defaults in code when unset;
# an invalid value falls back to the "ended" (hidden) state.
NEXT_PUBLIC_EVENT_DATETIME=2026-12-26T18:30:00+07:00

# Auto-preview the pre-launch page: when "true", visiting /prelaunch before
# launch redirects to /prelaunch?preview=1 (reviewer preview — bypasses the
# launch gate for the session). Independent of VERCEL_ENV so any environment
# can opt in. Plain server var (read at runtime, no rebuild). Leave unset/false
# in production once the embargo must hold. The manual /prelaunch?preview=1
# still works regardless of this flag.
PRELAUNCH_AUTO_PREVIEW=false

# ── Server / tooling secrets (NEVER prefix with NEXT_PUBLIC_) ─────────────────
# Used by scripts/seed-kudos.ts (`npm run db:seed`). Bypasses RLS.
# Supabase project: Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI credentials — let `supabase link` / `supabase db push` run
# non-interactively (see docs/setup/supabase-migrations.md).
# Access token: https://supabase.com/dashboard/account/tokens
# DB password: Supabase project → Settings → Database → Database password.
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_DB_PASSWORD=your-db-password
