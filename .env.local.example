# Supabase — copy this file to `.env.local` and fill in your project values.
# Get these from your Supabase project: Settings → API.
# See docs/setup/supabase-google-oauth.md for the full setup guide.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Homepage hero countdown target (ISO-8601). Defaults to this value in code
# when unset; an invalid value falls back to the "ended" (hidden) state.
NEXT_PUBLIC_EVENT_DATETIME=2026-12-26T18:30:00+07:00
